# Copia estos valores al entorno de ejecución de IntelliJ y reemplaza los marcadores.
# No pegues aquí credenciales reales ni agregues un archivo .env al repositorio.
DB_URL=jdbc:postgresql://localhost:5432/marketplace_db
DB_USERNAME=marketplace_app
DB_PASSWORD=REEMPLAZAR_CON_LA_CLAVE_DEL_ROL_POSTGRES

# Usa una cadena Base64 de al menos 32 bytes aleatorios.
APP_JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_BASE64_ALEATORIO
APP_JWT_ISSUER=arbnb-softpasty
APP_TIME_ZONE=America/Bogota
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Se requiere si aún no existe la cuenta administradora.
ADMIN_EMAIL=admin@marketplace.local
ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_DE_12_CARACTERES_O_MAS

# Para iniciar el cargador de cuentas y publicaciones demo, usa el perfil dev.
APP_DEMO_HOST_PASSWORD=REEMPLAZAR_MINIMO_8_CARACTERES
APP_DEMO_GUEST_PASSWORD=REEMPLAZAR_MINIMO_8_CARACTERES

# Opcional: habilita el envío real de enlaces de recuperación por correo.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=contraseña-de-aplicación
MAIL_FROM=tu-correo@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
APP_FRONTEND_URL=http://localhost:5173

# Vite usa localhost:8080 por defecto; descomenta si tu backend vive en otra URL.
# VITE_API_PROXY_TARGET=http://localhost:8080
